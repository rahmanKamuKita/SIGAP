# Matikan daftar isi folder
Options -Indexes

# Blokir file sensitif dari akses web
<FilesMatch "(^\.env|\.(sql|log|txt|md|bak)$|^(config|buat_akun)\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>